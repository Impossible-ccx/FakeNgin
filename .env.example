# Copy to .env and fill in your own endpoint, key and model.
# Process environment variables take precedence over .env.
MODEL_API_BASE_URL=http://your-model-server:3333/v1
MODEL_API_KEY=
MODEL_API_MODEL=your-model-name
MODEL_API_TIMEOUT=60
MODEL_API_MAX_TOKENS=1024

# Set a persistent random secret to preserve Flask sessions across restarts.
FLASK_SECRET_KEY=

# Optional Ollama adapter (requires the ollama Python package and service).
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_TIMEOUT=60
